[Unit]
Description=Nameplate Discord voice overlay
PartOf=graphical-session.target
After=graphical-session.target
# A crash loop should give up rather than respawn forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# systemd user services do not inherit a login shell's PATH, so the overlay
# would start without ever finding the bridge and show nothing.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# At login the unit can win the race against the compositor, and quickshell
# exits immediately without a Wayland socket to bind to. Wait for one.
ExecStartPre=/usr/bin/timeout 30 /bin/sh -c 'until [ -n "$WAYLAND_DISPLAY" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; do sleep 0.2; done'
ExecStart=/usr/bin/quickshell -c nameplate
Restart=on-failure
RestartSec=3
Slice=app.slice

[Install]
WantedBy=graphical-session.target
